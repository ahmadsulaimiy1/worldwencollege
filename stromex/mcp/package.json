{
  "name": "@stromex/enterprise-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "StromeX Enterprise Infrastructure MCP — one authenticated, audited, policy-governed automation layer over Cloudflare, GitHub, Neon, Vercel, Clerk, Resend and Brevo.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "stromex-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "test:unit": "npm run build && node --test \"dist/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/test/integration/**/*.test.js\"",
    "test:e2e": "npm run build && node --test \"dist/test/e2e/**/*.test.js\"",
    "start": "node dist/index.js",
    "doctor": "node dist/index.js doctor",
    "catalogue": "node dist/index.js catalogue --format=markdown"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "libsodium-wrappers": "^0.8.4",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
