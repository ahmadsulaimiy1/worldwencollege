# Every value below is a placeholder. None of these are set anywhere
# real. Copy to .env.local for local `wrangler pages dev` testing
# (never commit the real .env.local), and set the same names as
# Pages secrets for production — see docs/technical-architecture.md.

# --- Auth (Clerk) ---
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_replace_me
# CLERK_AUTHORIZED_PARTIES=https://worldwencollege.co.uk,https://www.worldwencollege.co.uk
# ^ optional, comma-separated allowed origins (the token's `azp` claim).
# Commented out / unset means this check is skipped — recommended to
# set once this Clerk instance backs more than one frontend, since
# otherwise any token signed by keys behind CLERK_JWKS_URL is accepted
# regardless of which Clerk-connected application minted it. See
# docs/auth-architecture.md § Security hardening.

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

PAYSTACK_SECRET_KEY=sk_test_replace_me
# Paystack webhooks are verified with the same secret key above — no
# separate webhook secret exists for Paystack.

FLW_SECRET_KEY=FLWSECK_replace_me
FLW_WEBHOOK_SECRET_HASH=replace_me
# ^ a static string you set in the Flutterwave dashboard yourself,
# not something Flutterwave generates for you.

OPAY_MERCHANT_ID=replace_me
OPAY_PUBLIC_KEY=replace_me
OPAY_SECRET_KEY=replace_me
# ^ verify field names against Opay's current merchant docs before
# using — see the CONFIDENCE FLAG in
# functions/_lib/payments/opay-adapter.js.

# --- Notifications ---
RESEND_API_KEY=re_replace_me
RESEND_FROM_ADDRESS=admissions@worldwencollege.co.uk
# ^ must be a domain verified in Resend before sending will work.

NOTIFICATION_EMAIL=admissions@worldwencollege.co.uk
# ^ where WEC-LC staff (not the applicant) are alerted about new
# applications — see notifyStaff() in
# functions/_lib/notifications/events.js. During early operations this
# can point anywhere reachable (a personal inbox is fine); switch it to
# an official mailbox later by changing this one value and redeploying
# — no code change required either way. Leaving it unset simply skips
# the staff alert (logged, not thrown) rather than failing the
# applicant's submission.
